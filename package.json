{
  "name": "negociaja",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "security:check": "node scripts/security-check.mjs",
    "db:local": "wrangler d1 migrations apply negocia-ja-bd --local",
    "db:remote": "wrangler d1 migrations apply negocia-ja-bd --remote",
    "db:remote:list": "wrangler d1 migrations list negocia-ja-bd --remote",
    "check": "npm run typecheck && node --check public/app.js && npm run security:check && wrangler deploy --dry-run"
  },
  "dependencies": {
    "jose": "6.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260813.1",
    "typescript": "5.9.2",
    "wrangler": "4.123.0"
  }
}
