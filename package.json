{
  "name": "negociaja",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/assert-production-deploy.mjs",
    "deploy:dry": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply negocia-ja-bd --local",
    "db:remote": "wrangler d1 migrations apply negocia-ja-bd --remote",
    "db:status:remote": "wrangler d1 migrations list negocia-ja-bd --remote",
    "db:audit:remote": "node scripts/audit-d1-remote.mjs",
    "audit:worker": "node scripts/check-single-worker.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "typescript": "^5.9.2",
    "wrangler": "4.31.0"
  }
}
