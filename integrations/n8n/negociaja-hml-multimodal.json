      "parameters": { "jsCode": "const mime=$json.mime_type||'image/jpeg'; const raw=String($json.base64||'').includes(',')?String($json.base64).split(',').pop():String($json.base64||''); if(!raw) throw new Error('Evolution não enviou base64 da imagem.'); return [{json:{...$json,ai_content:[{type:'input_text',text:'Analise a imagem enviada pelo cliente e considere a legenda/contexto: '+($json.body||'')},{type:'input_image',image_url:`data:${mime};base64,${raw}`}]}}];" },
