      "parameters": {
        "jsCode": "const b=$json.body||$json; const d=b.data||b; const m=d.message||{}; const key=d.key||{}; const jid=key.remoteJid||d.remoteJid||b.remoteJid||''; const phone=String(jid).split('@')[0]; let kind='text', text=''; if(m.audioMessage||d.messageType==='audioMessage') kind='audio'; else if(m.imageMessage||d.messageType==='imageMessage') kind='image'; else if(m.documentMessage||d.messageType==='documentMessage') kind='document'; text=m.conversation||m.extendedTextMessage?.text||m.imageMessage?.caption||d.text||b.text||''; const base64=d.base64||m.base64||b.base64||d.message?.base64||''; const mime=m.audioMessage?.mimetype||m.imageMessage?.mimetype||m.documentMessage?.mimetype||d.mimetype||''; return [{json:{provider:'evolution',external_event_id:String(key.id||d.id||b.id||Date.now()),instance:String(b.instance||d.instance||'hml'),phone,customer_name:d.pushName||b.pushName||'Contato',channel_type:'whatsapp',channel_name:'WhatsApp HML',external_conversation_id:jid||phone,content_type:kind,body:text,base64,mime_type:mime,file_name:m.documentMessage?.fileName||''}}];"
