          { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }, "conditions": [{ "leftValue": "={{ $json.content_type }}", "rightValue": "image", "operator": { "type": "string", "operation": "equals" }], "combinator": "and" }, "renameOutput": true, "outputKey": "image" }
        ] },
