{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "negociaja",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
  // Bindings já conectados no painel Cloudflare:
  // D1: DB -> negocia-ja-bd
  // R2: FILES -> negocia-ja-files
}
